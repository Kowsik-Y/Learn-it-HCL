# ===================================
# Learn-it HCL — Environment Variables
# ===================================
# Copy this file to .env and fill in the values

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://learnit:learnit_dev@localhost:5432/learnit
DATABASE_URL_SYNC=postgresql://learnit:learnit_dev@localhost:5432/learnit
POSTGRES_USER=learnit
POSTGRES_PASSWORD=learnit_dev
POSTGRES_DB=learnit

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT ----
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ---- AI Providers ----
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_AI_API_KEY=your-google-ai-key-here

# Default AI provider: openai | anthropic | google | local
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini

# Local model (Ollama)
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1

# ---- APISIX ----
APISIX_ADMIN_KEY=learn-it-hcl-apisix-admin-key-change-in-prod

# ---- App ----
APP_ENV=development
APP_DEBUG=true
APP_NAME=Learn-it HCL
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:9080/api/v1
NEXT_PUBLIC_APP_NAME=Learn-it HCL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Feature Flags ----
FF_AI_TUTOR=true
FF_GAMIFICATION=true
FF_ADAPTIVE_DIAGNOSTICS=true
FF_CAREER_PATH_MODE=true
FF_ATTENDANCE=true
FF_SHORT_VIDEO_MODE=true
